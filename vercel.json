{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.9 --activate && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/katika-bet run build",
  "outputDirectory": "artifacts/katika-bet/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://katika-w8bs.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
