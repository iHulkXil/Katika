{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@9.15.9 install --filter @workspace/sidebet... --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.15.9 --filter @workspace/sidebet run build",
  "outputDirectory": "artifacts/katika-bet/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://katika-w8bs.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
