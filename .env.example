# Client-safe App ID. Never put PRIVY_APP_SECRET in VITE_* variables.
PRIVY_APP_ID=
VITE_PRIVY_APP_ID=

# Server only. Required to verify Privy tokens on GET /api/me.
PRIVY_APP_SECRET=

# Server only. Required to persist users.
DATABASE_URL=

PORT=5173
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:5000

# Sepolia only. Paste after Remix deploy. Never use mainnet addresses.
VITE_SEPOLIA_CHIP=
VITE_SEPOLIA_VAULT=
