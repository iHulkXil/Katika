{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && (pnpm install --filter @workspace/katika-bet... --prod=false || npx --yes pnpm@9.15.9 install --filter @workspace/katika-bet... --no-frozen-lockfile --prod=false)",
  "buildCommand": "cd ../.. && (pnpm --filter @workspace/katika-bet run build || npx --yes pnpm@9.15.9 --filter @workspace/katika-bet run build)",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://katika-w8bs.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://katika-w8bs.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
